# Copia este archivo como .env y llena los valores. .env nunca se sube a git.
# El endpoint real de RDS se copia de la consola (RDS → Databases → Connectivity);
# no se versiona.
PGHOST=<instancia>.<id>.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=billing
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=./certs/global-bundle.pem

# Aplicación Flask
# Genera el secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_MINUTOS=60
# false sólo en desarrollo local por http; en AWS (https) debe ser true
COOKIE_SEGURA=true
# true sólo en local: muestra los usuarios de demostración en el login.
# En Lambda no se define (queda apagado).
MOSTRAR_CUENTAS_DEMO=false
# Sólo para pytest: la contraseña de las cuentas de demo en la base de .env
# (la que pusiste con scripts/cambiar_contrasenas_demo.py). No va en Lambda.
CONTRASENA_DEMO=

# Opcional: tabla de DynamoDB para la bitácora de eventos (vacía = sólo log local)
DDB_TABLA_EVENTOS=
AWS_REGION=us-east-1
