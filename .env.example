# Copia este archivo como .env y llena los valores. .env nunca se sube a git.
# Si el Learner Lab cambia el endpoint, sólo se actualiza PGHOST aquí.
PGHOST=db-billing-postgres.c7aen0lsxvo7.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=billing
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=./certs/global-bundle.pem

# Aplicación Flask
# Genera el secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_MINUTOS=60
# false sólo en desarrollo local por http; en AWS (https) debe ser true
COOKIE_SEGURA=true

# Opcional: tabla de DynamoDB para la bitácora de eventos (vacía = sólo log local)
DDB_TABLA_EVENTOS=
AWS_REGION=us-east-1
